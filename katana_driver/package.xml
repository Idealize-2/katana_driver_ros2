<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>katana_driver</name>
  <version>2.0.0</version>
  <description>
    ROS 2 hardware interface plugin for the Neuronics Katana 450 robot arm.
    Bridges the KNI SDK (kni package) with ros2_control / MoveIt 2.
  </description>

  <maintainer email="tanatoy78@gmail.com">kayz</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <depend>ament_index_cpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>kni</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- Register the pluginlib plugin -->
    <hardware_interface plugin="${prefix}/katana_hardware.xml"/>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>katana_test</name>
  <version>0.2.0</version>
  <description>
    Diagnostic and test tools for the Katana 400 arm.
    Contains low-level KNI utilities (encoder_reader, arm_disable_encoder,
    katana_kni_teleop) and MoveIt-based pose_runner.
  </description>

  <maintainer email="kukakthesery4@gmail.com">kay</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>kni</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

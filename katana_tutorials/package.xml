<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>katana_tutorials</name>
  <version>2.0.0</version>
  <description>
    ROS 2 tutorial and demo programs for the Neuronics Katana 400 arm.

    Tutorials 1-3 use the rclcpp_action / FollowJointTrajectory interface
    (they require ros2_control + katana_driver to be running).
  </description>

  <maintainer email="tanatoy78@gmail.com">kayz</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 action tutorials (1-3) -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>

  <!-- Tutorial 4: direct KNI (ik_pose_mover) -->
  <depend>kni</depend>
  <depend>ament_index_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="katana_450_6m90a_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <!-- <plugin>mock_components/GenericSystem</plugin>-->
                
                <!-- Real hardware plugin — connects to the Katana arm over TCP -->
                <plugin>katana_driver/KatanaHardwareInterface</plugin>

                <!-- ── Connection parameters ───────────────────────────────────
                     ip_address   : IP of the Katana controller (set on the arm's
                                    onboard PC or USB-Ethernet adapter).
                     config_file  : Absolute path to the .cfg file that matches your
                                    arm variant (katana6M180_F.cfg or _G.cfg etc.).
                                    The files live in:
                                    install/kni/share/kni/KNI_4.3.0/configfiles450/
                     calibrate_on_startup : set to "false" if the arm is already
                                           homed and you don't want it to recalibrate.
                ──────────────────────────────────────────────────────────────── -->
                <param name="ip_address">192.168.1.1</param>
                <param name="tcp_port">5566</param>
                <param name="config_file">$(find kni)/share/kni/KNI_4.3.0/configfiles450/katana6M180_F.cfg</param>
                <param name="calibrate_on_startup">true</param>
            </hardware>
            <joint name="katana_motor1_pan_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_motor1_pan_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_motor2_lift_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_motor2_lift_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_motor3_lift_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_motor3_lift_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_motor4_lift_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_motor4_lift_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_motor5_wrist_roll_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_motor5_wrist_roll_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_l_finger_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_l_finger_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="katana_r_finger_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['katana_r_finger_joint']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>

        </ros2_control>
    </xacro:macro>
</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_katana_description</name>
  <version>1.0.0</version>
  <description>
    This package contains an URDF description of the mobile Katana arm and all supporting mesh files.
  </description>
  <author>Kayz</author>
  <maintainer email="tanatoy78@gmail.com">Kayz</maintainer>
  <license>GPL</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>katana_description</exec_depend>
  <exec_depend>mobile_base_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

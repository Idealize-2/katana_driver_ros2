<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />

    <link name="base_footprint" />

    <link name="mobile_base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <material name="blue" />
        </visual>
        <collision>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
            <mass value="5.0" />
            <inertia
                ixx="${(1/12.0) * 5.0 * (base_width**2  + base_height**2)}"
                ixy="0" ixz="0"
                iyy="${(1/12.0) * 5.0 * (base_length**2 + base_height**2)}"
                iyz="0"
                izz="${(1/12.0) * 5.0 * (base_length**2 + base_width**2)}" />
        </inertial>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <mass value="0.5" />
                <inertia
                    ixx="${(1/12.0) * 0.5 * (3 * wheel_radius**2 + wheel_length**2)}"
                    ixy="0" ixz="0"
                    iyy="${(1/12.0) * 0.5 * (3 * wheel_radius**2 + wheel_length**2)}"
                    iyz="0"
                    izz="${0.5 * 0.5 * wheel_radius**2}" />
            </inertial>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" />

    <link name="caster_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius / 2.0}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.1" />
            <inertia
                ixx="${(2/5.0) * 0.1 * (wheel_radius / 2.0)**2}"
                ixy="0" ixz="0"
                iyy="${(2/5.0) * 0.1 * (wheel_radius / 2.0)**2}"
                iyz="0"
                izz="${(2/5.0) * 0.1 * (wheel_radius / 2.0)**2}" />
        </inertial>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="mobile_base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="mobile_base_link" />
        <child link="right_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="mobile_base_link" />
        <child link="left_wheel_link" />
        <origin xyz="${-base_length / 4.0} ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="mobile_base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="${base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
    </joint>

</robot>